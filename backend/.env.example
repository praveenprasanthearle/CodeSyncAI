# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection
DATABASE_URL=mongodb://127.0.0.1:27017/codesync_ai

# Authentication & Security
JWT_ACCESS_SECRET=codesync_ai_dev_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=codesync_ai_dev_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=codesync_ai_cookie_secret_998877

# AI Engine (Google Gemini / OpenAI)
AI_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-6-luna
AI_TIMEOUT_MS=45000
GEMINI_API_KEY=
OPENAI_API_KEY=

# Execution Configuration
# Local mode is for trusted development code; production requires docker or disabled.
EXECUTION_MODE=local
SANDBOX_IMAGE=codesync-runner:1
DOCKER_HOST=
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MAX_MEMORY_MB=256
